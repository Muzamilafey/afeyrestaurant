# ── Chili POS API configuration ── (placeholders only — never commit real values)
NODE_ENV=development
PORT=4000
# A replica set is required (transactions). A single-node replica set is fine: mongod --replSet rs0
MONGODB_URI=mongodb://127.0.0.1:27017/chili_pos?replicaSet=rs0
# Public HTTPS base URL of the API — used for M-Pesa callback URLs
PUBLIC_API_URL=http://localhost:4000
# Required in production to use the web first-run setup screen (or run `npm run setup`). Remove after setup.
SETUP_TOKEN=
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# 32 random bytes, base64: openssl rand -base64 32  (encrypts integration secrets at rest — back it up!)
SECRETS_ENCRYPTION_KEY=
COOKIE_SECURE=false
TRUST_PROXY=loopback
LOG_LEVEL=info
# Mock providers (M-Pesa/SMS/email) for development only. Always disabled when NODE_ENV=production.
ALLOW_MOCK_PROVIDERS=true
# Run the background worker inside the API process (set false when running dist/worker.js separately under PM2)
RUN_WORKER_IN_PROCESS=true
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Optional: comma-separated Safaricom callback source IPs. Empty = rely on per-attempt callback tokens.
MPESA_CALLBACK_IP_ALLOWLIST=
# Optional: where scripts/backup.sh writes its status file
BACKUP_STATUS_FILE=
