    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.6",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
