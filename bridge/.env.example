# Chili Bridge — runs on a PC on the restaurant LAN (placeholders only)
CHILI_API_URL=https://api.example.co.ke
# Issued once under Integrations → Local bridges → Register bridge
CHILI_BRIDGE_TOKEN=cbr_xxx
# How often to fetch print jobs and device commands
POLL_SECONDS=4
# Local HTTP port for the fingerprint kiosk page and browser print requests (bound to 127.0.0.1)
LOCAL_PORT=9632
# Browser origins allowed to call the local bridge (your POS web address)
ALLOWED_ORIGINS=https://pos.example.co.ke
# Shared secret the POS browser sends to the local bridge (X-Bridge-Local-Token)
LOCAL_TOKEN=change-me
# Time zone of attendance terminals (device clocks have no zone information)
DEVICE_TZ=Africa/Nairobi
# Minutes between automatic attendance downloads from ZKTeco terminals
ATTENDANCE_PULL_MINUTES=5
# SecuGen WebAPI (SGIBioSrv) on this PC — https://webapi.secugen.com
SECUGEN_WEBAPI_URL=https://localhost:8443
SECUGEN_LICENSE=
# 32-byte base64 key encrypting fingerprint templates stored locally by this bridge (SecuGen only)
TEMPLATE_KEY=
