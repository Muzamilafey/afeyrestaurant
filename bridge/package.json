{
  "name": "@chili/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Chili POS local bridge: ESC/POS printers, cash drawers, ZKTeco terminals and SecuGen readers",
  "type": "commonjs",
  "main": "dist/index.js",
